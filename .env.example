COMPANIES_HOUSE_API_KEY=
OPENAI_API_KEY=

# Postgres holding the Companies House bulk data, loaded by
# scripts/load_companies.py. Managed providers need sslmode=require, e.g.
# postgresql://user:pass@host/dbname?sslmode=require
DATABASE_URL=

# Optional overrides (see src/config.py for defaults)
# OPENAI_RESEARCH_MODEL=gpt-5.6-luna
# OPENAI_QUERY_MODEL=gpt-5.6-luna
# OPENAI_AUDITOR_MODEL=gpt-5.6-terra
# MAX_RESEARCH_TURNS=8
# MAX_AUDITOR_TURNS=2
# WEB_SEARCH_CONTEXT_SIZE=medium
# OPENAI_AGENTS_TRACING_ENABLED=false
